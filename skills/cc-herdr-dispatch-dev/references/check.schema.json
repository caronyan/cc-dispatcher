{
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "findings"],
  "properties": {
    "verdict": { "type": "string", "enum": ["LGTM", "ISSUES"] },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "category", "location", "problem", "evidence", "expected"],
        "properties": {
          "severity": { "type": "string", "enum": ["must", "should"], "description": "must：不修不能合入；should：建议改进" },
          "category": { "type": "string", "enum": ["correctness", "contract", "edge-case", "test-quality", "style"] },
          "location": { "type": "string", "description": "文件:行号" },
          "problem": { "type": "string" },
          "evidence": { "type": "string", "description": "能说明问题存在的代码或推理" },
          "expected": { "type": "string", "description": "期望的行为或修法方向" }
        }
      }
    }
  }
}
